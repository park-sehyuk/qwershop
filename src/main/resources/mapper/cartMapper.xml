    <select id="getCartList" resultType="com.example.qwershop.user.cart.dto.CartDetailDto">
        SELECT
            c.cart_id as cartId,
            i.item_name as itemNm,
            i.item_price as price,
            c.count as count
        FROM cart c
            JOIN item i ON c.item_id = i.item_id
        WHERE c.member_id = 7  </select>
